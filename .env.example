# Mozilla Data Collective API credentials.
# Copy to .env and paste your key from:
# https://mozilladatacollective.com → Account → Credentials
MDC_API_KEY=

# Where the ~79 GB tar.gz archive is stored (resumable downloads use this path).
# Prefer a path under this repo's gitignored data/ directory.
MDC_DOWNLOAD_PATH=./data/raw

# Optional: SDK log file location (useful if a download stops mid-way).
# MDC_LOG_PATH=./data/raw/datacollective.log

# --- Accent Oracle API (uvicorn) — never commit real secrets ---
# Comma-separated browser origins. Never use *. Empty → localhost Vite defaults.
# Same-origin production behind Caddy can leave this empty or list the public origin.
# ORACLE_CORS_ORIGINS=

# Emit Strict-Transport-Security on API responses (1/true/yes). Prefer proxy HSTS too.
# ORACLE_ENABLE_HSTS=0

# Build / release metadata (also used as Sentry release fallback).
# ORACLE_APP_VERSION=
# ORACLE_GIT_SHA=
# ORACLE_BUILT_AT=

# Legal policy string — keep aligned with web LEGAL_POLICY_VERSION.
# ORACLE_POLICY_VERSION=

# Trust X-Forwarded-For for in-memory rate limiting only (never persisted).
# ORACLE_TRUST_PROXY=0

# Audio / encode guards
# ORACLE_MAX_AUDIO_SECONDS=25
# ORACLE_WORKERS=2
# ORACLE_MAX_QUEUE_SIZE=20
# ORACLE_ENCODE_CONCURRENCY=1 # deprecated compatibility fallback for ORACLE_WORKERS
# ORACLE_ENCODE_RETRY_AFTER=5

# In-process sliding-window rate limits (not multi-worker safe).
# ORACLE_ANALYZE_RATE_LIMIT=10
# ORACLE_ANALYZE_RATE_WINDOW=60
# ORACLE_FEEDBACK_RATE_LIMIT=30
# ORACLE_FEEDBACK_RATE_WINDOW=60
# ORACLE_TELEMETRY_RATE_LIMIT=60
# ORACLE_TELEMETRY_RATE_WINDOW=60

# Research retention
# ORACLE_PENDING_CONSENT_TTL_SECONDS=1800
# ORACLE_RESEARCH_RETENTION_YEARS=3

# --- Observability (backend / uvicorn) — never commit real secrets ---
# Sentry (errors, logs, 10% traces). Off in development unless SENTRY_ENABLE_DEV=1.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_ENABLE_DEV=0

# Grafana Cloud OTLP metrics (request/inference counters, process CPU/memory).
# GRAFANA_OTLP_ENDPOINT=
# GRAFANA_OTLP_API_KEY=
