{
  "title": "Accent Oracle — Operations",
  "uid": "accent-oracle-operations",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": ["accent-oracle", "operations"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_requests_total[5m])) * 60",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(accent_oracle_http_request_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(accent_oracle_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average inference duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_inference_duration_seconds_sum[5m])) / clamp_min(sum(rate(accent_oracle_inference_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "avg inference"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "P95 inference duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(accent_oracle_inference_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 inference"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backend failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_requests_total{status_class=\"5xx\"}[5m])) * 60",
          "legendFormat": "5xx/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(accent_oracle_analyze_total{result=\"failure\"}[5m])) * 60",
          "legendFormat": "analyze failures/min"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(system_cpu_time_seconds_total{state=\"user\"}[5m])) or sum(rate(process_cpu_seconds_total[5m]))",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_runtime_memory_bytes{type=\"rss\"} or process_resident_memory_bytes or max(process_memory_usage_bytes)",
          "legendFormat": "rss"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "UI events / min",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(accent_oracle_ui_event_total[5m])) * 60",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Product funnel",
      "description": "Event counts over the dashboard range. No cookies or browser storage, so these are counts rather than unique browsers. Step-to-step % is this step divided by the previous step. Order: 01 homepage, 02 recording started, 03 recording completed, 04 analyze pressed, 05 analysis completed, 06 result, 07 retry from the results screen.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Step to step %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false },
        "sortBy": [{ "displayName": "step", "desc": false }]
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "sum by (step) (increase(accent_oracle_funnel_total[$__range]))"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "label_replace(vector(100), \"step\", \"01_homepage\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"02_recording_started\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"01_homepage\"}[$__range])), 1)) * 100, \"step\", \"02_recording_started\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"03_recording_completed\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"02_recording_started\"}[$__range])), 1)) * 100, \"step\", \"03_recording_completed\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"04_analyze_pressed\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"03_recording_completed\"}[$__range])), 1)) * 100, \"step\", \"04_analyze_pressed\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"05_analysis_completed\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"04_analyze_pressed\"}[$__range])), 1)) * 100, \"step\", \"05_analysis_completed\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"06_result\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"05_analysis_completed\"}[$__range])), 1)) * 100, \"step\", \"06_result\", \"step\", \".*\") or label_replace((sum(increase(accent_oracle_funnel_total{step=\"07_retry\"}[$__range])) / clamp_min(sum(increase(accent_oracle_funnel_total{step=\"06_result\"}[$__range])), 1)) * 100, \"step\", \"07_retry\", \"step\", \".*\")"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "step", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true },
            "renameByName": {
              "Value #A": "Count",
              "Value #B": "Step to step %",
              "Value 1": "Count",
              "Value 2": "Step to step %"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Startup seconds",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(accent_oracle_startup_seconds)",
          "legendFormat": "startup"
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] }
}
