{
  "title": "Accent Oracle — Operations",
  "uid": "accent-oracle-operations",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["accent-oracle", "operations"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / min",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_requests_total[5m])) * 60",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Average latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_request_duration_seconds_sum[5m])) / clamp_min(sum(rate(accent_oracle_http_request_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "P95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(accent_oracle_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average inference duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_inference_duration_seconds_sum[5m])) / clamp_min(sum(rate(accent_oracle_inference_duration_seconds_count[5m])), 1e-9)",
          "legendFormat": "avg inference"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "P95 inference duration",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(accent_oracle_inference_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 inference"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Backend failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accent_oracle_http_requests_total{status_class=\"5xx\"}[5m])) * 60",
          "legendFormat": "5xx/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(accent_oracle_analyze_total{result=\"failure\"}[5m])) * 60",
          "legendFormat": "analyze failures/min"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(system_cpu_time_seconds_total{state=\"user\"}[5m])) or sum(rate(process_cpu_seconds_total[5m]))",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_runtime_memory_bytes{type=\"rss\"} or process_resident_memory_bytes or max(process_memory_usage_bytes)",
          "legendFormat": "rss"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "UI events / min",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(accent_oracle_ui_event_total[5m])) * 60",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] }
}
