# Copy to web/.env.local (gitignored) for local API + legal identity.

# Inference mode: mock (default) | api
# VITE_ACCENT_ORACLE_MODE=api
# VITE_ACCENT_ORACLE_API_URL=http://127.0.0.1:8000
# VITE_ACCENT_ORACLE_DEV=1

# Phone LAN (npm run dev:lan): leave API URL empty so Vite proxies to :8000
# under HTTPS (mic needs a secure context; avoids mixed-content blocks).
# VITE_ACCENT_ORACLE_MODE=api
# VITE_ACCENT_ORACLE_API_URL=
# VITE_ACCENT_ORACLE_DEV=1

# GitHub Pages production build: use the public Hugging Face Space API URL.
# VITE_ACCENT_ORACLE_MODE=api
# VITE_ACCENT_ORACLE_API_URL=https://miquelt-9-accents-cat-api.hf.space

# Research storage is disabled by default. Re-enable only after updating the
# privacy policy and setting ORACLE_RETAIN_USER_DATA=1 on the API backend.
# VITE_RESEARCH_RETENTION_ENABLED=1

# Required before public launch (privacy policy + Manage My Data).
# VITE_PRIVACY_EMAIL=you@example.com
# VITE_CONTROLLER_NAME=Nom Cognom

# Optional promo URL on the results share card (defaults to window.location.host).
# VITE_PUBLIC_SITE_URL=https://example.com

# --- Build metadata (CI injects these for Sentry release) ---
# VITE_APP_VERSION=0.1.0
# VITE_GIT_SHA=
# VITE_BUILD_TIME=

# --- Observability (Sentry) ---
# The Pages workflow enables diagnostics; Sentry requires a DSN to initialize.
# Its error-only replay masks text and blocks media. Set this as a repository variable.
# VITE_DIAGNOSTICS_ENABLED=1
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_ENABLE_DEV=0

# --- Product analytics (PostHog Cloud EU) ---
# Pages enables allowlisted event names; PostHog also needs a project key.
# Set these as GitHub Actions repository variables. Never put PII in events.
# VITE_PRODUCT_ANALYTICS_ENABLED=1
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
